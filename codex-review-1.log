44:export async function POST(req: Request) {
45:  let body: unknown
46:  try {
47:    body = await req.json()
48:  } catch {
49:    return Response.json({ error: 'Invalid JSON body' }, { status: 400 })
50:  }
51:
52:  const parsed = requestSchema.safeParse(body)
53:  if (!parsed.success) {
54:    return Response.json({ error: 'Invalid request shape' }, { status: 400 })
55:  }
56:
57:  const { graph, session, input } = parsed.data
58:  const deps: RunDeps = { generateAiReply }
59:
60:  try {
61:    const result = await runFlow(graph, session, input, deps)
62:    return Response.json(result)
63:  } catch (err) {
64:    logError(err)
65:    return Response.json({ error: 'Flow execution failed' }, { status: 500 })
66:  }
67:}
