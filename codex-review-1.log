1:import { createOpenAI } from '@ai-sdk/openai'
2:import { generateText } from 'ai'
3:import { z } from 'zod'
4:import { type RunDeps, runFlow } from '@/lib/flow/engine'
5:import { type BotMessage, flowGraphSchema } from '@/lib/flow/types'
6:
7:const MAX_INPUT_CHARS = 4_000
8:
9:const requestSchema = z.object({
10:  graph: flowGraphSchema,
11:  session: z.object({
12:    currentNodeId: z.string().nullable(),
13:    variables: z.record(z.string(), z.string()),
14:    transcript: z.array(z.object({ role: z.enum(['bot', 'user']), text: z.string() })),
15:  }),
16:  input: z.string().max(MAX_INPUT_CHARS).nullable(),
17:})
18:
19:/** Real AI dependency for the engine â€” calls OpenAI. Server-only. */
20:async function generateAiReply(
21:  systemPrompt: string,
22:  model: string,
23:  transcript: BotMessage[],
24:): Promise<string> {
25:  const apiKey = process.env.OPENAI_API_KEY
26:  if (!apiKey) throw new Error('OPENAI_API_KEY is not set')
27:  const openai = createOpenAI({ apiKey })
28:  const messages = transcript.map((m) => ({
29:    role: m.role === 'bot' ? ('assistant' as const) : ('user' as const),
30:    content: m.text,
31:  }))
32:  const result =
33:    messages.length > 0
34:      ? await generateText({ model: openai(model), system: systemPrompt, messages })
35:      : await generateText({ model: openai(model), system: systemPrompt, prompt: 'ã“ã‚“ã«ã¡ã¯' })
36:  return result.text
37:}
