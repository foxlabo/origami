1:import type { BotMessage, FlowGraph, FlowSession } from './types'
2:
3:/** Injected dependency so the engine stays pure and unit-testable. */
4:export interface RunDeps {
5:  generateAiReply: (
6:    systemPrompt: string,
7:    model: string,
8:    transcript: BotMessage[],
9:  ) => Promise<string>
10:}
11:
12:export type RunStatus = 'awaiting-input' | 'ended' | 'error'
13:
14:export interface RunResult {
15:  session: FlowSession
16:  /** Bot messages emitted during this step (not including prior transcript). */
17:  messages: BotMessage[]
18:  status: RunStatus
19:  error?: string
20:}
21:
22:/** Safety cap: max node visits in a single step, guards against graph loops. */
23:const MAX_STEPS = 200
24:
25:/** Replace `{{variable}}` placeholders in text with session variable values. */
26:export function interpolate(text: string, variables: Record<string, string>): string {
27:  return text.replace(/\{\{\s*(\w+)\s*\}\}/g, (_, key: string) => variables[key] ?? '')
28:}
29:
30:/** Resolve the next node id by following an outgoing edge from `nodeId`. */
31:function followEdge(graph: FlowGraph, nodeId: string, handle?: string): string | null {
32:  const outgoing = graph.edges.filter((e) => e.source === nodeId)
33:  if (handle !== undefined) {
34:    const exact = outgoing.find((e) => (e.sourceHandle ?? 'else') === handle)
35:    if (exact) return exact.target
36:    const fallback = outgoing.find((e) => (e.sourceHandle ?? 'else') === 'else')
37:    return fallback?.target ?? null
38:  }
39:  return outgoing[0]?.target ?? null
40:}
41:
42:/**
43: * Advance a flow run by one step.
44: *
45: * - With `input === null` and a fresh session, the run starts at the `start` node.
46: * - With `input` set and the session paused on a `question`, the input is stored
47: *   in that question's variable and the run continues.
48: *
49: * The run walks forward emitting messages until it hits a `question`
50: * (â†’ `awaiting-input`) or terminates (â†’ `ended`).
51: */
52:export async function runFlow(
53:  graph: FlowGraph,
54:  session: FlowSession,
55:  input: string | null,
56:  deps: RunDeps,
57:): Promise<RunResult> {
58:  const nodeById = new Map(graph.nodes.map((n) => [n.id, n]))
59:  const messages: BotMessage[] = []
60:  const variables: Record<string, string> = { ...session.variables }
61:  const transcript: BotMessage[] = [...session.transcript]
62:
63:  const fail = (error: string, currentNodeId: string | null): RunResult => ({
64:    session: { currentNodeId, variables, transcript },
65:    messages,
66:    status: 'error',
67:    error,
68:  })
69:
70:  // Resolve the node to begin walking from.
71:  let currentId: string | null
72:
73:  if (session.currentNodeId === null) {
74:    const start = graph.nodes.find((n) => n.type === 'start')
75:    if (!start) return fail('Flow has no start node', null)
76:    currentId = start.id
77:  } else {
78:    const paused = nodeById.get(session.currentNodeId)
79:    if (!paused) return fail(`Paused node "${session.currentNodeId}" not found`, null)
80:    if (paused.type !== 'question') {
81:      return fail('Session is paused on a non-question node', session.currentNodeId)
82:    }
83:    if (input === null) {
84:      // Still waiting â€” nothing to advance.
85:      return { session: { ...session }, messages, status: 'awaiting-input' }
86:    }
87:    variables[paused.data.variable] = input
88:    transcript.push({ role: 'user', text: input })
89:    currentId = followEdge(graph, paused.id)
90:  }
91:
92:  let steps = 0
93:  while (currentId !== null) {
94:    if (++steps > MAX_STEPS) {
95:      return fail('Flow exceeded the maximum step count (possible loop)', currentId)
96:    }
97:
98:    const node = nodeById.get(currentId)
99:    if (!node) return fail(`Edge points to missing node "${currentId}"`, null)
100:
101:    switch (node.type) {
102:      case 'start': {
103:        currentId = followEdge(graph, node.id)
104:        break
105:      }
106:      case 'message': {
107:        const text = interpolate(node.data.text, variables)
108:        messages.push({ role: 'bot', text })
109:        transcript.push({ role: 'bot', text })
110:        currentId = followEdge(graph, node.id)
111:        break
112:      }
113:      case 'question': {
114:        const prompt = interpolate(node.data.prompt, variables)
115:        messages.push({ role: 'bot', text: prompt })
116:        transcript.push({ role: 'bot', text: prompt })
117:        return {
118:          session: { currentNodeId: node.id, variables, transcript },
119:          messages,
120:          status: 'awaiting-input',
121:        }
122:      }
123:      case 'condition': {
124:        const value = variables[node.data.variable] ?? ''
125:        const matched = node.data.cases.find((c) => c.value === value)
126:        currentId = followEdge(graph, node.id, matched ? matched.value : 'else')
127:        break
128:      }
129:      case 'ai': {
130:        let reply: string
131:        try {
132:          reply = await deps.generateAiReply(node.data.systemPrompt, node.data.model, transcript)
133:        } catch (err) {
134:          return fail(err instanceof Error ? err.message : 'AI node failed', node.id)
135:        }
136:        messages.push({ role: 'bot', text: reply })
137:        transcript.push({ role: 'bot', text: reply })
138:        currentId = followEdge(graph, node.id)
139:        break
140:      }
141:      case 'end': {
142:        return {
143:          session: { currentNodeId: null, variables, transcript },
144:          messages,
145:          status: 'ended',
146:        }
147:      }
148:    }
149:
150:    if (currentId === null) {
151:      // Dead end (no outgoing edge) â€” treat as a graceful finish.
152:      return {
153:        session: { currentNodeId: null, variables, transcript },
154:        messages,
155:        status: 'ended',
156:      }
157:    }
158:  }
159:
160:  return { session: { currentNodeId: null, variables, transcript }, messages, status: 'ended' }
161:}
